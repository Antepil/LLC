{
  "schema_version": "llc-neural-ode-validation-v2",
  "hardware_config_file": "configs/matlab/hardware.json",
  "control_config": {"file": "configs/matlab/closed_loop_data_generation.json", "section": "control"},
  "steady_state_config": {"file": "configs/matlab/closed_loop_data_generation.json", "section": "steady_state_assessment"},
  "model_export": {
    "file": "artifacts/models/llc_neural_ode/model_export.mat",
    "required_schema_version": "llc-neural-ode-matlab-export-v1",
    "load_abs_tolerance_ohm": 1.0e-9,
    "consistency_abs_tolerance": 1.0e-12,
    "consistency_relative_tolerance": 1.0e-12
  },
  "reference_plant": {"model_file": "matlab/models/llc_full_bridge_closed_loop.slx"},
  "paths": {
    "simulink_comparison_model_file": "matlab/models/llc_neural_ode_comparison.slx"
  },
  "solver": {
    "name": "ode23t",
    "max_step_s": 9.090909090909091e-8,
    "relative_tolerance": 1.0e-5,
    "absolute_tolerance": 1.0e-7,
    "event_time_tolerance_s": 1.0e-12,
    "fail_on_nonfinite_state": true,
    "convergence_check": {"enabled": true, "max_step_factor": 0.5, "tolerance_factor": 0.1}
  },
  "comparison_sampling": {
    "reference_frequency_hz": 110000.0,
    "intervals_per_cycle": 100,
    "state_interpolation": "linear",
    "gate_interpolation": "previous"
  },
  "experiments": [
    {
      "experiment_id": "recorded_gate_replay_vin400_r2p304_vref52p8",
      "enabled": true,
      "mode": "recorded_gate_replay",
      "reference_trajectory_file": "data/raw/llc_closed_loop_extended_5ms/trajectory_0008_closed_loop_vin400_r2p304_vref52p8.mat"
    },
    {
      "experiment_id": "cold_start_closed_loop_baseline",
      "enabled": true,
      "mode": "independent_closed_loop",
      "startup": {"mode": "cold", "evaluation_duration_s": 0.005},
      "condition": {"load_ohm": 2.304},
      "vin": {"type": "constant", "value_v": 400.0},
      "reference": {"type": "constant", "value_v": 48.0}
    },
    {
      "experiment_id": "warm_start_closed_loop_baseline",
      "enabled": true,
      "mode": "independent_closed_loop",
      "startup": {
        "mode": "warm",
        "preheat_duration_s": 0.005,
        "evaluation_duration_s": 0.005,
        "require_steady_state": true,
        "extend_preheat_on_failure": false
      },
      "condition": {"load_ohm": 2.304},
      "preheat_vin": {"type": "constant", "value_v": 400.0},
      "preheat_reference": {"type": "constant", "value_v": 48.0},
      "vin": {"type": "constant", "value_v": 400.0},
      "reference": {"type": "constant", "value_v": 48.0}
    }
  ],
  "metrics": {
    "state_metrics": ["rmse", "normalized_rmse_by_model_state_scale", "maximum_absolute_error", "final_absolute_error"],
    "output_voltage_metrics": ["mean_absolute_error", "reference_tracking_rmse", "tail_mean_error"],
    "tail_window_s": 0.0004,
    "acceptance_thresholds": null
  },
  "output": {
    "directory": "artifacts/matlab_neural_ode_validation",
    "save_resolved_config": true,
    "save_waveforms": true,
    "save_metric_tables": true,
    "save_figures": true
  }
}
